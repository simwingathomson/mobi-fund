{
  "name": "mobifund",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "npm --workspace apps/api run start:dev",
    "dev:admin": "npm --workspace apps/admin run dev",
    "dev:mobile": "npm --workspace apps/mobile run start",
    "db:generate": "npm --workspace packages/database run generate",
    "db:migrate": "npm --workspace packages/database run migrate",
    "db:migrate:dev": "npm --workspace packages/database run migrate:dev",
    "db:seed": "npm --workspace packages/database run seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
