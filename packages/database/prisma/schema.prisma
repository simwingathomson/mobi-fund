generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  LOAN_OFFICER
}
enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}
enum DocumentType {
  NATIONAL_ID
  SELFIE
  PROOF_OF_ADDRESS
  LOAN_AGREEMENT
  RECEIPT
}
enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
  ACTIVE
  PAID
  DEFAULTED
}
enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

model User {
  id            String          @id @default(uuid())
  name          String
  phone         String          @unique
  email         String          @unique
  passwordHash  String
  role          Role            @default(CUSTOMER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  profile       CustomerProfile?
  notifications Notification[]
  auditLogs     AuditLog[]
}

model CustomerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  nrcNumber          String             @unique
  address            String
  employment         String
  repaymentPhone     String?
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents          Document[]
  loans              Loan[]
}

model Document {
  id           String             @id @default(uuid())
  customerId   String
  documentType DocumentType
  fileUrl      String
  status       VerificationStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  customer     CustomerProfile    @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model LoanProduct {
  id            String   @id @default(uuid())
  name          String
  minimumAmount Decimal  @db.Decimal(12, 2)
  maximumAmount Decimal  @db.Decimal(12, 2)
  interestRate  Decimal  @db.Decimal(5, 2)
  durationDays  Int
  fees          Decimal  @default(0) @db.Decimal(12, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  loans         Loan[]
}

model Loan {
  id             String          @id @default(uuid())
  customerId     String
  loanProductId  String
  amount         Decimal         @db.Decimal(12, 2)
  interest       Decimal         @db.Decimal(12, 2)
  totalRepayment Decimal         @db.Decimal(12, 2)
  status         LoanStatus      @default(PENDING)
  approvedDate   DateTime?
  dueDate        DateTime?
  createdAt      DateTime        @default(now())
  customer       CustomerProfile @relation(fields: [customerId], references: [id])
  loanProduct    LoanProduct     @relation(fields: [loanProductId], references: [id])
  payments       Payment[]
  schedules      RepaymentSchedule[]
}

model Payment {
  id                   String        @id @default(uuid())
  loanId               String
  amount               Decimal       @db.Decimal(12, 2)
  paymentMethod        String
  transactionReference String        @unique
  status               PaymentStatus @default(PENDING)
  paymentDate          DateTime      @default(now())
  receiptUrl           String?
  loan                 Loan          @relation(fields: [loanId], references: [id])
}

model RepaymentSchedule {
  id        String        @id @default(uuid())
  loanId    String
  dueDate   DateTime
  amount    Decimal       @db.Decimal(12, 2)
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  loan      Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  message    String
  readStatus Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
}
